// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum EventType {
  CONCERT
  SPORTS
  PILGRIMAGE
  FESTIVAL
  EXHIBITION
  CONFERENCE
  COLLEGE_FEST
  OTHER
}

enum EventStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum LocationType {
  GATE
  EXIT
  STAGE
  STALL
  WASHROOM
  MEDICAL
  HELP_POINT
  PARKING
  WATER_POINT
  OTHER
}

enum FacilityStatus {
  AVAILABLE
  BUSY
  FULL
  CLOSED
  MAINTENANCE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences UserPreference?
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  priceSensitivity  Int?
  crowdPreference   Int?
  walkingPreference Int?
  accessibility     Boolean  @default(false)
  brandPreference   String?
  foodPreferences   Json?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  eventType   EventType
  startTime   DateTime
  endTime     DateTime
  status      EventStatus @default(DRAFT)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  venues Venue[]
}

model Venue {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  description String?
  latitude    Float?
  longitude   Float?
  mapData     Json?
  createdAt   DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zones Zone[]
}

model Zone {
  id          String   @id @default(uuid())
  venueId     String
  name        String
  description String?
  capacity    Int?
  geometry    Json?
  createdAt   DateTime @default(now())

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  locations Location[]
}

model Location {
  id          String       @id @default(uuid())
  zoneId      String
  name        String
  type        LocationType
  latitude    Float
  longitude   Float
  description String?
  isActive    Boolean      @default(true)

  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  facilities Facility[]
}

model Facility {
  id          String         @id @default(uuid())
  locationId  String
  name        String
  type        String
  status      FacilityStatus @default(AVAILABLE)
  capacity    Int?
  description String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}
