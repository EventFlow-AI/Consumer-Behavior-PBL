// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum EventType {
  CONCERT
  SPORTS
  PILGRIMAGE
  FESTIVAL
  EXHIBITION
  CONFERENCE
  COLLEGE_FEST
  OTHER
}

enum EventStatus {
  DRAFT
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum LocationType {
  GATE
  EXIT
  STAGE
  STALL
  WASHROOM
  MEDICAL
  HELP_POINT
  PARKING
  WATER_POINT
  OTHER
}

enum FacilityStatus {
  AVAILABLE
  BUSY
  FULL
  CLOSED
  MAINTENANCE
}

enum IncidentType {
  MEDICAL
  SECURITY
  FIRE
  CROWD
  LOST_PERSON
  INFRASTRUCTURE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AnnouncementPriority {
  INFO
  IMPORTANT
  URGENT
}

enum InteractionType {
  VIEW
  CLICK
  SELECT
  SAVE
  REDEEM
}

enum ChoiceFactor {
  PRICE
  DISCOUNT
  DISTANCE
  CROWD
  QUEUE
  BRAND_FAMILIARITY
  CONVENIENCE
  OTHER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences UserPreference?
  incidents   Incident[]
  interactions ConsumerInteraction[]
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  priceSensitivity  Int?
  crowdPreference   Int?
  walkingPreference Int?
  accessibility     Boolean  @default(false)
  brandPreference   String?
  foodPreferences   Json?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String      @id @default(uuid())
  name        String
  description String?
  eventType   EventType
  startTime   DateTime
  endTime     DateTime
  status      EventStatus @default(DRAFT)
  imageUrl    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  venues Venue[]
  incidents Incident[]
  announcements Announcement[]
  offers       Offer[]
  interactions ConsumerInteraction[]
}

model Venue {
  id          String   @id @default(uuid())
  eventId     String
  name        String
  description String?
  latitude    Float?
  longitude   Float?
  mapData     Json?
  createdAt   DateTime @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zones Zone[]
}

model Zone {
  id          String   @id @default(uuid())
  venueId     String
  name        String
  description String?
  capacity    Int?
  geometry    Json?
  createdAt   DateTime @default(now())

  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  locations Location[]
}

model Location {
  id          String       @id @default(uuid())
  zoneId      String
  name        String
  type        LocationType
  latitude    Float
  longitude   Float
  description String?
  isActive    Boolean      @default(true)

  zone       Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  facilities Facility[]
  incidents  Incident[]
}

model Facility {
  id          String         @id @default(uuid())
  locationId  String
  name        String
  type        String
  status      FacilityStatus @default(AVAILABLE)
  capacity    Int?
  description String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model Incident {
  id          String           @id @default(uuid())
  eventId     String
  locationId  String?
  reportedById String
  type        IncidentType
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(OPEN)
  title       String
  description String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reportedBy User      @relation(fields: [reportedById], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([locationId])
  @@index([status])
  @@index([severity])
}
model Announcement {
  id        String               @id @default(uuid())
  eventId   String
  title     String
  message   String
  priority  AnnouncementPriority @default(INFO)
  isActive  Boolean              @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([priority])
  @@index([isActive])
}

model Brand {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers       Offer[]
  interactions ConsumerInteraction[]

  @@index([category])
  @@index([isActive])
}
model Offer {
  id          String   @id @default(uuid())
  brandId     String
  eventId     String
  title       String
  description String?
  discountText String?
  price       Float?
  isActive    Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  interactions ConsumerInteraction[]

  @@index([brandId])
  @@index([eventId])
  @@index([isActive])
}
model ConsumerInteraction {
  id        String          @id @default(uuid())
  userId    String
  eventId   String
  brandId   String?
  offerId   String?
  action    InteractionType
  factor    ChoiceFactor?
  rating    Int?
  metadata  Json?
  createdAt DateTime        @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([brandId])
  @@index([offerId])
  @@index([action])
  @@index([factor])
}
